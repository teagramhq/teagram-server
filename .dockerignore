# Build stages copy only explicit Go source directories, the sticker generator,
# and deploy/photothumb-runtime/, so ignored files cannot reach a layer.
# This is the second lock: it keeps the files out of the context uploaded to the
# daemon.

# Key material and configuration. *.pem covers server_key.pem, which
# rsakey.LoadOrGenerate writes into the working directory of a local run.
*.pem
*.key
.env
.env.*
testdata/photothumb/

# Full history — anything ever committed and later removed comes back with it.
.git
/build/
**/node_modules/

# Local-only and agent-runtime directories; the latter can hold credentials.
bin/
plans/
.claude/
.multica/
