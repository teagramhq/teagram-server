# Configuration for the local docker-compose.yml stack.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored and must stay that way: it holds the master key that
# decrypts every stored auth key. A copy of this file with real values in it is
# not an example, and 0644 is the default umask on most machines.

# Password for the local Postgres. 5432 is not published anywhere, so an
# obviously-local literal is the honest value — a random-looking one is worse,
# because a reader cannot tell it from live material.
#
# Keep it to [A-Za-z0-9_-]: it is interpolated into a URL, and a password like
# p@ss makes the DSN parse "ss@postgres" as the host.
POSTGRES_PASSWORD=localdev

# HTTPS origin returned by help.getConfig and used for server-owned links.
# This reserved test domain keeps local links away from official origins. Set a
# reachable TLS hostname if your clients need to open those links.
TG_PUBLIC_LINK_PREFIX=https://links.example.test/

# Bootstrap the RSA server identity once before `docker compose up` with:
#   docker compose run --rm --no-deps teagramd bootstrap-identity
# For a replica deployment, set this to the fingerprint printed by bootstrap
# and use the same value on every replica. TG_REPLICA_ID requires this pin.
TG_RSA_KEY_FINGERPRINT=

# AES-256-GCM master key over every auth key at rest. 64 hex chars.
#
# Leave it empty only for local, unpinned single-replica work, with both
# TG_REPLICA_ID and TG_RSA_KEY_FINGERPRINT unset:
# docker-compose.yml points the server at /var/lib/teagramd/enc_key.hex on the
# tgkey volume, and it generates a key there on first boot and reuses it on
# every restart. The log warns that a generated key is a dev key.
#
# Set it — `openssl rand -hex 32` — for anything that is not a laptop, where the
# key belongs in whatever holds your other secrets rather than in a container
# volume. A value here wins and no file is written. Replica deployments must
# configure the same key on every replica, or provision the same existing key
# file at TG_AUTHKEY_ENC_KEY_FILE. When either identity pin is set, a missing
# file is never generated.
#
# No default is committed here on purpose: a working one gets copied somewhere
# that is not local, the server starts fine, and every auth key ends up sealed
# under a key that is public in git.
TG_AUTHKEY_ENC_KEY=

# RustFS credentials are generated into this ignored file by:
#   ./deploy/bootstrap-rustfs-secrets.sh
# The script keeps this file at mode 0600 and refuses partial credentials, so
# it cannot silently rotate a key after RustFS has been initialized. The app
# secret is also written to .secrets/teagramd-blob-secret-key for Compose's
# read-only bind mount into teagramd.
RUSTFS_ROOT_ACCESS_KEY=
RUSTFS_ROOT_SECRET_KEY=
TG_BLOB_S3_ACCESS_KEY_ID=
TG_BLOB_S3_SECRET_ACCESS_KEY=

# The media encryption key is external to this repository and is mounted
# read-only. Provision /etc/teagramd/media-keys/1.key on the box with 0600
# permissions, owned by uid/gid 65532. Keep its directory private (0700).
TEAGRAM_MEDIA_KEY_SOURCE_DIR=/etc/teagramd/media-keys
TG_MEDIA_KEY_CURRENT=1

# Local filesystem root used only when every TG_BLOB_S3_* variable is empty.
# The default Compose render selects RustFS and requires a valid durable
# blob-mode authority. `docker-compose.local-blobs.yml` selects the guarded
# initial-local backend during the reviewed rollout path.
# TG_BLOB_DIR=/var/lib/teagramd-blobs
#
# Whatever it is set to must stay outside anything a future HTTP surface serves
# statically: the bytes here are attacker-supplied and unvalidated.

# Legacy diagnostic only; current username/password sign-in does not use phone
# codes. This Compose stack pins it off because enabling it writes phone numbers
# and codes in cleartext to logs.
TG_LOG_LOGIN_CODES=false

# Registration is closed by default. On a fresh database, temporarily set this
# to `open` while creating the first account through auth.signUp, then set it
# back to `closed`; the first committed account becomes server administrator.
# TG_REGISTRATION=closed
# User-issued invite redemption is disabled unless this non-negative quota is positive.
# TG_USER_INVITE_QUOTA=0

# Optional, separately bound WebSocket endpoint for public browser traffic.
# Leave the address unset until the host publishes it on loopback (for example,
# 127.0.0.1:2446 on the host to :2446 in the container). Its registration mode
# defaults to closed and its browser origin allowlist is independent.
# TG_PUBLIC_WEBSOCKET_LISTEN_ADDR=:2446
# Set this only with the public listener; its host appears in that listener's
# discovery WebSocket URL, while the MTProto endpoint stays TG_ADVERTISE_ADDR.
# TG_PUBLIC_WEBSOCKET_ADVERTISE_ADDR=server.example.com:443
# TG_PUBLIC_REGISTRATION=closed
# TG_PUBLIC_WEBSOCKET_ALLOWED_ORIGINS=https://web.teagram.io

# Optional Cloudflare Turnstile gate for public auth.signUp. Compose maps these
# host-side credentials to the app's TG_TURNSTILE_* settings and mounts the
# secret file; see deploy/teagram/README.md for the file ownership requirements.
# This local Compose stack explicitly enables test mode with local hostnames.
# Test mode permits signup with Turnstile disabled, and accepts Cloudflare's
# official test key pairs if you want to exercise the widget. It rejects real
# secrets and any advertised teagram.io hostname. Never set it on a public stack.
# The base Compose file defaults to web.teagram.io; this local environment
# explicitly overrides that with localhost and 127.0.0.1.
TG_TURNSTILE_TEST_MODE=true
TG_TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# Optional Cloudflare test pair: pass site key 1x00000000000000000000AA or
# 2x00000000000000000000AB, and provide the matching official test secret in
# a separate local file. Sign-in remains disabled unless
# TG_TURNSTILE_SIGNIN_ENABLED=true.
# TEAGRAM_TURNSTILE_SITE_KEY=
# TEAGRAM_TURNSTILE_SECRET_KEY_FILE=
# TG_TURNSTILE_SIGNIN_ENABLED=false

# Public identity used by `teagramd client-config` and by the server log.
# Set this to the host:port clients should dial, not the address the process
# necessarily binds. Leave it commented to derive the value from TG_LISTEN_ADDR.
# TG_ADVERTISE_ADDR=mtproto.example.com:443
# TG_DC_ID=2

# Admitted local-direct preflight response-attempt bounds. These are separate
# from the connection and pre-auth bounds: the defaults admit 60 valid requests
# across the deployment per minute and 10 per IPv4 /32 or IPv6 /64 per minute.
# Counters are shared in Postgres. Set either count to 0 to disable that bound.
# Keep the windows positive while enabled.
# TG_RATE_LIMIT_DISCOVERY=60
# TG_RATE_LIMIT_DISCOVERY_WINDOW=1m
# TG_RATE_LIMIT_DISCOVERY_IP=10
# TG_RATE_LIMIT_DISCOVERY_IP_WINDOW=1m

# Maximum number of teagramd replicas running at once. Set the same value on
# every replica; local connection budgets are divided by this count.
# TG_REPLICA_COUNT=1

# Optional stable deployment identity shown on authenticated admin metrics.
# Setting it requires TG_RSA_KEY_FINGERPRINT to pin the shared server identity.
# It is not inferred from the host, pod, client, or network address. Use only
# letters, digits, '.', '_' and '-' and keep it at 64 characters or fewer.
# TG_REPLICA_ID=edge-2
