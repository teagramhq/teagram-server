{
  "name": "teagram",
  "networks": {
    "default": {
      "ipam": {},
      "name": "teagram_default"
    },
    "public-backend": {
      "driver": "bridge",
      "enable_ipv6": false,
      "internal": true,
      "ipam": {
        "config": [
          {
            "gateway": "198.18.132.1",
            "subnet": "198.18.132.0/24"
          }
        ]
      },
      "name": "teagram_public-backend"
    },
    "public-ingress": {
      "driver": "bridge",
      "enable_ipv6": false,
      "ipam": {
        "config": [
          {
            "gateway": "198.18.131.1",
            "subnet": "198.18.131.0/24"
          }
        ]
      },
      "name": "teagram_public-ingress"
    },
    "rustfs_private": {
      "driver": "bridge",
      "driver_opts": {
        "com.docker.network.bridge.gateway_mode_ipv4": "isolated"
      },
      "enable_ipv6": false,
      "internal": true,
      "ipam": {},
      "name": "teagram_rustfs_private"
    }
  },
  "secrets": {
    "rustfs_root_access_key": {
      "environment": "RUSTFS_ROOT_ACCESS_KEY",
      "name": "teagram_rustfs_root_access_key"
    },
    "rustfs_root_secret_key": {
      "environment": "RUSTFS_ROOT_SECRET_KEY",
      "name": "teagram_rustfs_root_secret_key"
    },
    "teagramd_blob_secret_key": {
      "file": "./fixture-secret",
      "name": "teagram_teagramd_blob_secret_key"
    },
    "teagramd_turnstile": {
      "file": "./fixture-secret",
      "name": "teagram_teagramd_turnstile"
    }
  },
  "services": {
    "public-haproxy": {
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "cpus": 0.25,
      "depends_on": {
        "teagramd": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "healthcheck": {
        "interval": "10s",
        "retries": 3,
        "start_period": "10s",
        "test": [
          "CMD",
          "wget",
          "-q",
          "-O",
          "/dev/null",
          "http://127.0.0.1:8404/healthz"
        ],
        "timeout": "3s"
      },
      "image": "mirror.gcr.io/library/haproxy:3.2-alpine@sha256:51f173c6825753d9e3a888b1004a1c2cb730936cc9178730a5c555246bd161a2",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "100663296",
      "memswap_limit": "100663296",
      "networks": {
        "public-backend": {
          "ipv4_address": "198.18.132.10"
        },
        "public-ingress": {
          "ipv4_address": "198.18.131.10"
        }
      },
      "pids_limit": 64,
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "2446",
          "target": 2446
        }
      ],
      "profiles": [
        "public"
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "stop_grace_period": "2m0s",
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "/fixture/deploy/teagramd/haproxy-public-websocket.cfg",
          "target": "/usr/local/etc/haproxy/haproxy.cfg",
          "type": "bind"
        }
      ]
    },
    "teagramd": {
      "build": {
        "args": {
          "TEAGRAMD_SOURCE_REVISION": ""
        },
        "context": ".",
        "dockerfile": "Dockerfile"
      },
      "command": null,
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "rustfs-init": {
          "condition": "service_completed_successfully",
          "required": true
