      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "2443",
          "target": 2443
        }
      ],
      "read_only": true,
      "secrets": [
        {
          "source": "teagramd_blob_secret_key",
          "target": "teagramd-blob-secret-key"
        },
        {
          "source": "teagramd_turnstile",
          "target": "teagramd-turnstile"
        }
      ],
      "stop_grace_period": "2m0s",
      "volumes": [
        {
          "source": "tgkey",
          "target": "/var/lib/teagramd",
          "type": "volume",
          "volume": {}
        },
        {
          "read_only": true,
          "source": "tgblobs",
          "target": "/var/lib/teagramd-blobs",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {},
