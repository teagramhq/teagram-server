          "source": "/fixture/mount",
          "target": "/run/teagramd/blob-mode",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": false
          },
          "read_only": true,
          "source": "/fixture/mount",
          "target": "/run/teagramd/media-keys",
          "type": "bind"
        }
      ]
    },
