        "TG_KEY_EXCHANGE_GLOBAL_RATE": "fixture",
        "TG_KEY_EXCHANGE_PER_CONNECTION": "fixture",
        "TG_LOG_LOGIN_CODES": "fixture",
        "TG_MEDIA_KEY_CURRENT": "fixture",
        "TG_MEDIA_KEY_DIR": "fixture",
        "TG_POSTGRES_DSN": "fixture",
        "TG_PUBLIC_LINK_PREFIX": "fixture",
        "TG_PUBLIC_REGISTRATION": "invite",
        "TG_PUBLIC_WEBSOCKET_ADVERTISE_ADDR": "",
        "TG_PUBLIC_WEBSOCKET_ALLOWED_ORIGINS": "https://example.invalid",
        "TG_PUBLIC_WEBSOCKET_LISTEN_ADDR": "",
        "TG_RATE_LIMIT_KEY_EXCHANGE_IP": "fixture",
        "TG_RATE_LIMIT_KEY_EXCHANGE_IP_TAILNET": "fixture",
        "TG_RATE_LIMIT_KEY_EXCHANGE_IP_WINDOW": "fixture",
        "TG_REGISTRATION": "fixture",
        "TG_REPLICA_COUNT": "1",
        "TG_REPLICA_ID": "fixture",
        "TG_RSA_KEY_FINGERPRINT": "fixture",
        "TG_TURNSTILE_SECRET_KEY_FILE": "fixture",
        "TG_TURNSTILE_SIGNIN_ENABLED": "fixture",
        "TG_TURNSTILE_SITE_KEY": "fixture",
        "TG_WELCOME_CHANNEL": "fixture"
      },
      "image": "teagramd:local",
      "logging": {
        "driver": "syslog",
        "options": {
          "syslog-address": "unixgram:///dev/log",
          "syslog-facility": "daemon",
          "syslog-format": "rfc5424",
          "tag": "teagramd"
        }
