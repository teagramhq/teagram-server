# Copy to deploy/teagram-demo/.env on the demo LXC and chmod 0600.
# Generate both database values once with `openssl rand -hex 32`; never rotate
# them as part of a regular deployment or the weekly demo data reset. The
# Turnstile secret is kept in a separate root-only file by prepare-env.sh.
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-value
TG_AUTHKEY_ENC_KEY=replace-with-a-different-random-64-character-hex-value

TG_PUBLIC_LINK_PREFIX=https://demo.teagram.io/
TG_ADVERTISE_ADDR=demo.teagram.io:443
TG_ADVERTISE_DEMO_GUEST_SIGN_UP=true
TG_WEBSOCKET_LISTEN_ADDR=:2446
TG_WEBSOCKET_ALLOWED_ORIGINS=https://web.teagram.io,https://demo.teagram.io
TG_REGISTRATION=open
TG_TURNSTILE_SIGNIN_ENABLED=false
TG_LOG_LOGIN_CODES=false
TG_MAX_FILE_BYTES=16777216
TG_MAX_USER_STORAGE_BYTES=268435456
TG_UPLOADS_DISABLED=true
TEAGRAM_DEMO_BLOB_PATH=/srv/teagram-demo-blobs/data
TEAGRAM_DEMO_TURNSTILE_SITE_KEY=replace-with-demo-site-key
TEAGRAM_DEMO_TURNSTILE_SECRET_KEY_FILE=/var/lib/teagram-demo/secrets/turnstile-secret-key
