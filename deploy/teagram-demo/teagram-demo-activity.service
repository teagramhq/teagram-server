[Unit]
Description=Post one scheduled message in a seeded Teagram demo megagroup
After=docker.service network-online.target
Requires=docker.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/teagram-demo
EnvironmentFile=-/etc/default/teagram-demo-activity
LoadCredential=inventory.json:/var/lib/teagram-demo/secrets/demo-accounts/inventory.json
ExecStart=/opt/teagram-demo/deploy/teagram-demo/run-activity.sh
TimeoutStartSec=infinity
StateDirectory=teagram-demo-activity
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ProtectSystem=strict
ReadWritePaths=/var/lib/teagram-demo-activity /run/docker.sock /var/run/docker.sock
